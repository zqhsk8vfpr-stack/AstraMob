local function isWeapon(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local cached = _weaponClassCache[tool]
    if cached ~= nil then return cached end
    local name = tool.Name
    local raw = name:match("%[(.-)%]") or name
    raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
    local result = true
    for _, non in ipairs(NON_WEAPON_NAMES) do
        if raw:lower() == non:lower() then
            result = false
            break
        end
    end
    _weaponClassCache[tool] = result
    return result
end

