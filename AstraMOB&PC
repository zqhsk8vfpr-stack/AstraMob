local function clearSticky()
    stickyPlayer = nil
    hasEverPicked = false
    currentTarget = nil
    SilentTarget = nil
end

local function cycleTarget()
    local enemies = getValidEnemies()
    if #enemies == 0 then
        stickyPlayer = nil
        hasEverPicked = false
        currentTarget = nil
        SilentTarget = nil
        return
    end
    local currentIdx = 0
    if stickyPlayer then
        for i, data in ipairs(enemies) do
            if data.player == stickyPlayer then
                currentIdx = i
                break
            end
        end
    end
    local nextIdx = (currentIdx % #enemies) + 1
    stickyPlayer = enemies[nextIdx].player
    hasEverPicked = true
    currentTarget = enemies[nextIdx]
    if isSilentAimActive() then
        SilentTarget = currentTarget
    end
end

local function pickTargetUnderCrosshair()
    local enemies = getValidEnemies()
    if #enemies == 0 then return end
    local crosshair = Camera.ViewportSize * 0.5
    local best, bestDist = nil, math.huge
    local MAX_PIXEL_DIST = 120   -- forgiveness radius in pixels (tune this)
    for _, data in ipairs(enemies) do
        local char = data.character
        if char then
            local parts = getBodyParts(char)
            for _, part in ipairs(parts) do
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on then
                    local dx = sp.X - crosshair.X
                    local dy = sp.Y - crosshair.Y
                    local d = math.sqrt(dx * dx + dy * dy)
                    if d < bestDist then
                        bestDist = d
                        best = data
                    end
                end
            end
        end
    end
    if best and bestDist <= MAX_PIXEL_DIST then
        stickyPlayer = best.player
        hasEverPicked = true
        currentTarget = best
        if isSilentAimActive() then
            SilentTarget = currentTarget
        end
    end
end

