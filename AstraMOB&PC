local lastBuy = 0
local cache = {}

local _itemNameMap = {}
for cat, list in pairs(ALL_ITEMS) do
    for _, name in ipairs(list) do
        _itemNameMap[normaliseItemName(name)] = cat
    end
end

local cacheByModel = {}

local function tryCacheModel(inst)
    if not inst:IsA("Model") then return end
    if cacheByModel[inst] then return end
    local nameNorm = normaliseItemName(inst.Name)
    local cat = _itemNameMap[nameNorm]
    if not cat then return end
    local part = inst:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end
    local cd = inst:FindFirstChildWhichIsA("ClickDetector", true)
    local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
    local entry = {
        model = inst,
        part = part,
        cat = cat,
        name = inst.Name,
        nameNorm = nameNorm,
        cd = cd,
        prompt = prompt,
    }
    cacheByModel[inst] = entry
    cache[#cache + 1] = entry
end

local function onAutoBuyDescendantAdded(inst)
    if inst:IsA("Model") then
        tryCacheModel(inst)
    elseif inst:IsA("BasePart") then
        local parent = inst.Parent
        if parent and parent:IsA("Model") then
            tryCacheModel(parent)
        end
    end
end

local function onAutoBuyDescendantRemoving(inst)
    local entry = cacheByModel[inst]
    if not entry then return end
    cacheByModel[inst] = nil
    for i = #cache, 1, -1 do
        if cache[i] == entry then
            table.remove(cache, i)
            break
        end
    end
end

local _trackedParents = {}

local function scanAndCache(parent, depth)
    if not parent or depth > 6 then return end
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Model") then
            tryCacheModel(child)
            if cacheByModel[child] then
                local p = child.Parent
                if p and not _trackedParents[p] then
                    _trackedParents[p] = true
                    p.DescendantAdded:Connect(onAutoBuyDescendantAdded)
                    p.DescendantRemoving:Connect(onAutoBuyDescendantRemoving)
                end
            end
        end
        scanAndCache(child, depth + 1)
    end
end

local knownPaths = {
    workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop"),
    workspace:FindFirstChild("MAP") and workspace.MAP:FindFirstChild("Ignored") and workspace.MAP.Ignored:FindFirstChild("Shop"),
    workspace:FindFirstChild("Shop"),
}

local foundOne = false
for _, p in ipairs(knownPaths) do
    if p then
        for _, obj in ipairs(p:GetDescendants()) do
            if obj:IsA("Model") then tryCacheModel(obj) end
        end
        if #cache > 0 then
            _trackedParents[p] = true
            p.DescendantAdded:Connect(onAutoBuyDescendantAdded)
            p.DescendantRemoving:Connect(onAutoBuyDescendantRemoving)
            foundOne = true
            break
        end
    end
end

if not foundOne then
    scanAndCache(workspace, 0)
end

local function tryBuy(entry)
    if entry.cd and fireclickdetector then
        local ok = pcall(fireclickdetector, entry.cd)
        if ok then return true end
    end
    if entry.prompt and entry.prompt.Enabled then
        local ok = pcall(function() entry.prompt:InputHoldBegin() end)
        if not ok then
            pcall(function() entry.prompt:InputHoldEnd() end)
            return false
        end
        task.wait(0.05)
        pcall(function() entry.prompt:InputHoldEnd() end)
        return true
    end
    return false
end

local inventoryCount = {}

local function addInventoryItem(name)
    local n = normaliseItemName(name)
    if n == "" then return end
    inventoryCount[n] = (inventoryCount[n] or 0) + 1
end

local function removeInventoryItem(name)
    local n = normaliseItemName(name)
    if n == "" then return end
    local count = inventoryCount[n]
    if count then
        if count <= 1 then
            inventoryCount[n] = nil
        else
            inventoryCount[n] = count - 1
        end
    end
end

local function refreshInventoryCache()
    inventoryCount = {}
    local function addContainer(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") then
                addInventoryItem(child.Name)
            end
        end
    end
    addContainer(LocalPlayer.Backpack)
    addContainer(LocalPlayer.Character)
end

refreshInventoryCache()

if LocalPlayer.Backpack then
    LocalPlayer.Backpack.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then addInventoryItem(child.Name) end
    end)
    LocalPlayer.Backpack.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then removeInventoryItem(child.Name) end
    end)
end

local function hookCharacterInventory(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then addInventoryItem(child.Name) end
    end)
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then removeInventoryItem(child.Name) end
    end)
end

LocalPlayer.CharacterAdded:Connect(hookCharacterInventory)
if LocalPlayer.Character then hookCharacterInventory(LocalPlayer.Character) end

LocalPlayer.CharacterRemoving:Connect(function(char)
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then removeInventoryItem(child.Name) end
    end
end)

local function hasItem(entry)
    return inventoryCount[entry.nameNorm] ~= nil
end

task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            local ab = getTable('Auto Buy')
            if not ab.Enabled then return end
            local buyGun = ab.Guns
            local buyFood = ab.Food
            local buyArmor = ab.Armor

            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local pos = hrp.Position
            if tick() - lastBuy < (ab.Cooldown or 0) then return end
            local prox = ab.Proximity or 20
            local selectedGuns = ab['Selected Guns'] or {}
            local selectedFoods = ab['Selected Foods'] or {}
            if type(selectedGuns) == "string" then selectedGuns = {selectedGuns} end
            if type(selectedFoods) == "string" then selectedFoods = {selectedFoods} end

            local gunSet, foodSet = {}, {}
            for _, g in ipairs(selectedGuns) do gunSet[normaliseItemName(g)] = true end
            for _, f in ipairs(selectedFoods) do foodSet[normaliseItemName(f)] = true end
            local hasGunSel  = next(gunSet)  ~= nil
            local hasFoodSel = next(foodSet) ~= nil

            local bought = false
            for _, entry in ipairs(cache) do
                local shouldBuy = false
                if entry.cat == "Gun" and buyGun then
                    if hasGunSel then
                        shouldBuy = gunSet[entry.nameNorm] == true
                    else
                        shouldBuy = true
                    end
                elseif entry.cat == "Food" and buyFood then
                    if hasFoodSel then
                        shouldBuy = foodSet[entry.nameNorm] == true
                    else
                        shouldBuy = true
                    end
                elseif entry.cat == "Armor" and buyArmor then
                    shouldBuy = true
                end

                if shouldBuy and not hasItem(entry) then
                    local d = (entry.part.Position - pos).Magnitude
                    if d < prox then
                        if tryBuy(entry) then
                            bought = true
                            break
                        end
                    end
                end
            end
            if bought then
                lastBuy = tick()
            end
        end)
    end
end)

