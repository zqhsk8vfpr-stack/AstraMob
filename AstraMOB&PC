        end
        if not wallCheckResult then return end
    end

    local desiredCF = CFrame.lookAt(camPos, aimPos)

    if not getFlag("combat_target_outline", false) then
        local snapFactor = 1
        if getFlag("SmoothnessEnabled", false) then
            local smoothX = tonumber(getFlag("SmoothnessX", 0.1)) or 0.1
            local smoothY = tonumber(getFlag("SmoothnessY", 0.1)) or 0.1
            local baseSmooth = math.min(smoothX, smoothY)
            local style = getFlag("EasingStyle", "Linear")
            local dirE = getFlag("EasingDirection", "Out")
            snapFactor = getEasedValue(baseSmooth, style, dirE)
        end
        if snapFactor <= 0 then return end
        if snapFactor > 1 then snapFactor = 1 end
        Camera.CFrame = camCF:Lerp(desiredCF, snapFactor)
        return
    end

    local dirToTarget = aimPos - camPos
    if dirToTarget.Magnitude < 0.001 then return end
    local unitToTarget = dirToTarget.Unit

    local targetScreen, onScreen = Camera:WorldToViewportPoint(aimPos)
    if onScreen then
        local crosshair = Camera.ViewportSize * 0.5
        local dx = targetScreen.X - crosshair.X
        local dy = targetScreen.Y - crosshair.Y
        local pixelDist = math.sqrt(dx * dx + dy * dy)
        if pixelDist < DEADZONE_PX then
            return
        end
    end

    local movementDir = getMovementDirection()
    if movementDir and movementDir:Dot(unitToTarget) < MOVEMENT_DOT_MIN then
        return
    end

    local useAngle = getSetting("UseAngle", false) == true
    local maxPull = math.clamp(tonumber(getSetting("MaxPull", 0.35)) or 0.35, 0, 1)

    local dot = math.clamp(camLook:Dot(unitToTarget), -1, 1)
    local angularError = math.deg(math.acos(dot))

    local ratio

    if useAngle then
        local maxAngle = math.max(tonumber(getSetting("MaxAngle", 6)) or 6, 0.1)
        if angularError > maxAngle then return end
        ratio = angularError / maxAngle
    else
        local radiusStuds = math.max(tonumber(getSetting("RadiusStuds", 3)) or 3, 0.1)
        local projLength = dirToTarget:Dot(camLook)
        local closestPoint = camPos + camLook * projLength
        local perpendicularDist = (aimPos - closestPoint).Magnitude
        if perpendicularDist > radiusStuds then return end
        ratio = perpendicularDist / radiusStuds
    end

    local effectiveRatio = math.max(ratio, STICKY_MIN_RATIO)

    local stickyBoost = 1 + ratio * STICKY_BOOST

    local factor = effectiveRatio * maxPull * stickyBoost

    if getFlag("SmoothnessEnabled", false) then
        local smoothX = tonumber(getFlag("SmoothnessX", 0.1)) or 0.1
