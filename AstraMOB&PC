local _weaponClassCache = setmetatable({}, {__mode = "k"})
function isWeapon(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local cached = _weaponClassCache[tool]
    if cached ~= nil then return cached end
    local name = tool.Name
    local raw = name:match("%[(.-)%]") or name
    raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
    local result = true
    for _, non in ipairs(NON_WEAPON_NAMES) do
        if raw:lower() == non:lower() then
            result = false
            break
        end
    end
    _weaponClassCache[tool] = result
    return result
end

local function updateRealMotionAll()
    for i = 1, #playerCacheArray do
        local plr = playerCacheArray[i]
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            refreshCharRefs(char, false)
            local refs = getCharRefs(char)
            local root = refs.root
            if root then
                local now = tick()
                local prev, prevT = _prevPos[char], _prevPosTime[char]
                _prevPos[char]     = root.Position
                _prevPosTime[char] = now
                if prev and prevT then
                    local dt = now - prevT
                    if dt >= 0.001 then
                        local speed = (root.Position - prev).Magnitude / dt
                        local wasMoving = _realMoving[char] == true
                        if speed > 4 then
                            _realMoving[char] = true
                        elseif speed < 1.5 then
                            _realMoving[char] = false
                        else
                            _realMoving[char] = wasMoving
                        end
                    end
                else
                    _realMoving[char] = false
                end
            end
        end
    end
end

local function pollEnemyShots()
    for i = 1, #playerCacheArray do
        local plr = playerCacheArray[i]
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local tool = char:FindFirstChildWhichIsA("Tool")
            if tool and isWeapon(tool) then
                local ammoProp = tool:FindFirstChild("AMMO") or tool:FindFirstChild("Ammo") or tool:FindFirstChild("CurrentAmmo") or tool:FindFirstChild("Clip")
                if ammoProp and (ammoProp:IsA("NumberValue") or ammoProp:IsA("IntValue")) then
                    local prev = _prevEnemyAmmo[char]
                    if prev ~= nil and ammoProp.Value < prev then
                        _lastShotTime[char] = tick()
                    end
                    _prevEnemyAmmo[char] = ammoProp.Value
                end
            else
                _prevEnemyAmmo[char] = nil
            end
        end
    end
end

