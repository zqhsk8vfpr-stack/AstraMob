local function getFlag(name, default)
    local v = getgenv()[name]
    if v ~= nil then return v end
    if _G.flags and _G.flags[name] ~= nil then return _G.flags[name] end
    if library and library.flags and library.flags[name] ~= nil then return library.flags[name] end
    return default
end

local function getSetting(name, default)
    local v = getgenv()[name]
    if v ~= nil then return v end
    return default
end

local function getKeybindValue(flagName)
    local v = getgenv()[flagName]
    if v ~= nil then return v end
    if _G.flags and _G.flags[flagName] ~= nil then return _G.flags[flagName] end
    if library and library.flags and library.flags[flagName] ~= nil then return library.flags[flagName] end
    return nil
end

local function getKeybindKey(flagName, defaultKey)
    local v = getKeybindValue(flagName)
    if v == nil then return defaultKey end
    if typeof(v) == "EnumItem" then return v end
    if type(v) == "table" then
        if typeof(v.key) == "EnumItem" then return v.key end
        if typeof(v.keyCode) == "EnumItem" then return v.keyCode end
        if type(v.key) == "string" or type(v.key) == "number" then return v.key end
    end
    if type(v) == "string" or type(v) == "number" then return v end
    return defaultKey
end

local function getKeybindActive(flagName)
    local v = getKeybindValue(flagName)
    if type(v) == "boolean" then return v end
    if type(v) == "table" and v.active ~= nil then return v.active end
    return false
end

local function isSilentAimActive()
