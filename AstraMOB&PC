local function prepareSilentAim()
    if not isSilentAimActive() then return end

    if _perfMode.enabled and _perfMode.requireWeapon then
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildWhichIsA("Tool")
        if not tool or not isWeapon(tool) then return end
    end

    local char = LocalPlayer.Character
    local currentTool = char and char:FindFirstChildWhichIsA("Tool")
    if currentTool and not isWeapon(currentTool) then return end

    local hitChance = SA_getHitChance() or 85
    if currentTool then
        local weaponHit = getWeaponHitChance(currentTool)
        if weaponHit then hitChance = weaponHit end
    end
    if math.random(100) > hitChance then return end

    local targetPlayer = SilentTarget
    if not targetPlayer or not targetPlayer.character then return end
    if targetPlayer.character ~= targetPlayer.player.Character then return end
    local targetChar = targetPlayer.character

    local saChecks = SA_getChecks()
    if saChecks.Knocked and IsKnocked(targetChar) then return end
    if saChecks.Forcefield and hasForcefield(targetChar) then return end
    if saChecks.Friend and isFriendCached(targetPlayer.player) then return end
    if shouldSkipAntiAimer(targetChar) then return end

    local refs = getCharRefs(targetChar)
    local hum = refs.humanoid
    if not hum or hum.Health <= 0 then return end

    local aimPart = getSilentAimPart(targetChar)
    if not aimPart then return end
    if saChecks.Visible and not isVisible(aimPart.Position, targetChar) then return end

    local predCfg = getTable('Silent Aim', 'Prediction')
    local aimPos = computeSilentAimPosition(aimPart, predCfg, hitChance)

    if antiCurveShouldSkip(Camera.CFrame, aimPos) then return end

    if parseAntiGround("Silent Aim") then
        local groundHit = GetGroundIntersection(aimPos, targetChar, "Silent Aim")
        if groundHit then return end
    end

    fireSilentAim(aimPos)
end

