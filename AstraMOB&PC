local function pickTargetUnderCrosshair()
    local enemies = getValidEnemies()
    if #enemies == 0 then return end
    local crosshair = aimAssistCrosshair()
    local best, bestDist = nil, math.huge
    local MAX_PIXEL_DIST = 120
    for _, data in ipairs(enemies) do
        local char = data.character
        if char then
            local refs = getCharRefs(char)
            local root = data.rootPart
            local head = refs.head
            if root then
                local sp, on = Camera:WorldToViewportPoint(root.Position)
                if on then
                    local dx = sp.X - crosshair.X
                    local dy = sp.Y - crosshair.Y
                    local d = math.sqrt(dx * dx + dy * dy)
                    if d < bestDist then bestDist = d; best = data end
                end
            end
            if head then
                local sp, on = Camera:WorldToViewportPoint(head.Position)
                if on then
                    local dx = sp.X - crosshair.X
                    local dy = sp.Y - crosshair.Y
                    local d = math.sqrt(dx * dx + dy * dy)
                    if d < bestDist then bestDist = d; best = data end
                end
            end
        end
    end
    if best and bestDist <= MAX_PIXEL_DIST then
        stickyPlayer = best.player
        hasEverPicked = true
        currentTarget = best
        if A("Silent Aim", "Enabled", false) and _silentMaster then
            SilentTarget = currentTarget
        end
    end
end

