local function eatFood()
    if not getFlag("AutoEat", false) then return end
    if eatingPaused then
        if tick() < pauseEndTime then
            return
        else
            eatingPaused = false
        end
    end
    local threshold = getFlag("AutoEatThreshold", 75)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.Health <= 0 then return end
    local healthPercent = hum.Health / hum.MaxHealth * 100
    if healthPercent > threshold then return end
    local food = findFood()
    if not food then return end
    isEating = true
    currentEatingFood = food
    local currentTool = nil
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and child ~= food then
            currentTool = child
            break
        end
    end
    if currentTool then
        previousToolName = currentTool.Name
        currentTool.Parent = LocalPlayer.Backpack
        task.wait(0.15)
    else
        previousToolName = nil
    end
    if food.Parent ~= char then
        food.Parent = char
        task.wait(0.15)
    end
    if food.Parent ~= char then
        isEating = false
        currentEatingFood = nil
        return
    end
    local rawName = stripBrackets(food.Name)
    local activations = 1
    for _, stomp in ipairs(STOMP_FOODS) do
        if rawName:lower() == stomp:lower() then
            activations = 5
            break
        end
    end
    local safety = 0
    while hum.Health < hum.MaxHealth and safety < 40 do
        safety = safety + 1
        if not isEating then break end
        if food.Parent ~= char then
            food.Parent = char
            task.wait(0.15)
            if food.Parent ~= char then break end
        end
        for i = 1, activations do
            if food:IsA("Tool") and food.Parent == char then
                food:Activate()
            end
            task.wait(0.08)
        end
        if not food.Parent then
            food = findFood()
            if not food then break end
            currentEatingFood = food
            food.Parent = char
            task.wait(0.15)
        end
        task.wait(0.05)
    end
    isEating = false
    currentEatingFood = nil
    if hum.Health >= hum.MaxHealth and previousToolName then
        local backpack = LocalPlayer.Backpack
        if backpack then
            local toolToEquip = backpack:FindFirstChild(previousToolName)
            if toolToEquip and toolToEquip:IsA("Tool") then
                toolToEquip.Parent = char
                task.wait(0.15)
            end
        end
        previousToolName = nil
    end
end

