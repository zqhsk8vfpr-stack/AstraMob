}

local function calculatePingPrediction(ping)
    return (ping / 1000) + 0.037
end

local function interpolatePingPrediction(ping)
    if not ping or ping <= 0 then return 0.115 end
    local first = pingPredictionTable[1]
    local last  = pingPredictionTable[#pingPredictionTable]
    if ping < first[1] or ping > last[1] then
        return calculatePingPrediction(ping)
    end
    local prev, nxt = nil, nil
    for i = 1, #pingPredictionTable do
        local e = pingPredictionTable[i]
        if e[1] <= ping then prev = e
        else nxt = e; break end
    end
    if not prev then return nxt[2] end
    if not nxt  then return prev[2] end
    local t = (ping - prev[1]) / (nxt[1] - prev[1])
    return prev[2] + (nxt[2] - prev[2]) * t
end

local _lastPingInput = -1
local _lastPingPred  = 0.115
local function getPingPrediction(ping)
    if ping == _lastPingInput then return _lastPingPred end
    _lastPingInput = ping
    _lastPingPred  = interpolatePingPrediction(ping)
    return _lastPingPred
end

