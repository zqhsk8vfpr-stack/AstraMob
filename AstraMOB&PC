local function aimbotAcquireTargets()
    if not A("General", "Enabled", true) then
        currentTarget = nil; SilentTarget = nil; return
    end

    local aimCfg = getTable('Aim Assist')
    local saCfg  = getTable('Silent Aim')
    local aimOn  = aimCfg and aimCfg.Enabled == true and _aimMaster
    local saOn   = saCfg and saCfg.Enabled == true and _silentMaster

    if not aimOn and not saOn then
        currentTarget = nil; SilentTarget = nil; return
    end

    local now = tick()
    if now - _priorityCache.lastPoll > 0.2 then
        _priorityCache.lastPoll = now
        local rawPriority = tostring(aimCfg.TargetPriority or "Closest")
        if rawPriority ~= _priorityCache.priorityRaw then
            _priorityCache.priorityRaw = rawPriority
            local key = rawPriority:lower():gsub("[%s_%-]", "")
            _priorityCache.priority = TARGET_PRIORITY_MAP[key] or "closest"
        end
        _priorityCache.activation = aimCfg.Mode or "Hold"
        local sm = aimCfg.Smoothness or {}
        _smooth.x = tonumber(sm.X) or 0.25
        _smooth.y = tonumber(sm.Y) or 0.25

        local rawKey = aimCfg.Bind and aimCfg.Bind.AimbotKey
        local resolved = rawKey and getKeyCode(rawKey) or nil
        if resolved and (isKeyboardKeyCode(resolved) or mouseButtons[resolved] ~= nil) then
            _cachedAimbotKeyEnum = resolved
        else
            _cachedAimbotKeyEnum = nil
        end
    end

    if saOn and not aimOn then
        currentTarget = nil
        if isSilentAimActive() then
            SilentTarget = selectTarget(getValidEnemies())
        else
            SilentTarget = nil
        end
        return
    end

    local activation = _priorityCache.activation
    if _state.lastActivationMode == nil then
        _state.lastActivationMode = activation
    elseif activation ~= _state.lastActivationMode then
        _state.aimbotToggle = false
        _state.lastActivationMode = activation
        clearSticky()
    end

    if not passesPerspectiveCheck("Aim Assist") then
        currentTarget = nil
        SilentTarget = nil
        return
    end

    local shouldLock = false
    local enemiesList = nil
    local priority = _priorityCache.priority
    local physical = isAimbotKeyPhysicallyDown()

    if activation == "Rage" then
        shouldLock = true
        enemiesList = getValidEnemies()
        currentTarget = selectTarget(enemiesList)
    elseif activation == "Mobile" then
        if isTouching then
            shouldLock = true
            enemiesList = getValidEnemies()
            currentTarget = selectTarget(enemiesList)
        end
    elseif activation == "Hold" then
        if physical then
            shouldLock = true
            enemiesList = getValidEnemies()
        end
    elseif activation == "Toggle" then
        if _state.aimbotToggle then
            shouldLock = true
            enemiesList = getValidEnemies()
        end
    end

    if not shouldLock then
        currentTarget = nil
        SilentTarget = nil
        return
    end

    if activation ~= "Rage" and activation ~= "Mobile" then
        if stickyPlayer and not stickyPlayer.Parent then
            stickyPlayer = nil
            hasEverPicked = false
            _state.aimbotToggle = false
        end

        if not stickyPlayer and not hasEverPicked and priority ~= "manual" and enemiesList and #enemiesList > 0 then
            local pick = selectTarget(enemiesList)
            if pick then
                stickyPlayer = pick.player
                hasEverPicked = true
            end
        end

        currentTarget = nil
        if stickyPlayer then
            if enemiesList then
                for _, data in ipairs(enemiesList) do
                    if data.player == stickyPlayer then
                        currentTarget = data
                        break
                    end
                end
            end
            if not currentTarget then
                local spChar = stickyPlayer.Character
                local checks = AA_getChecks()
                local skipKnock = checks.Knocked and IsKnocked(spChar)
                local skipFF = checks.Forcefield and hasForcefield(spChar)
                if not skipKnock and not skipFF then
                    currentTarget = buildTargetFromPlayer(stickyPlayer)
                end
            end
        end
    end

    if not currentTarget then
        SilentTarget = nil
        return
    end

    if not currentTarget.player or not currentTarget.player.Parent then
        currentTarget = nil
        SilentTarget = nil
        return
    end

    if currentTarget.character ~= currentTarget.player.Character then
        local rebuilt = buildTargetFromPlayer(currentTarget.player)
        if rebuilt then
            currentTarget = rebuilt
        else
            SilentTarget = nil
            return
        end
    end

    if saOn and isSilentAimActive() then
        SilentTarget = currentTarget
    else
        SilentTarget = nil
    end

    if not aimOn then currentTarget = nil end
end

local _easingState = {
    target    = nil,
    startTime = 0,
}

local function aimbotUpdateCamera(dt)
    if not currentTarget then
        _easingState.target = nil
        return
    end
    local char = currentTarget.character
    local root = currentTarget.rootPart
    if not char or not char.Parent or not root or not root.Parent then
        _easingState.target = nil
        return
    end

    local aimPart = getAimPart(char)
    if not aimPart then aimPart = root end
    if not aimPart or not aimPart.Parent then
        _easingState.target = nil
        return
    end

    local camCF  = Camera.CFrame
    local camPos = camCF.Position
    local aimPos = aimPart.Position

    local predCfg = getTable('Aim Assist', 'Prediction')
    if predCfg and predictionActive(predCfg) then
        local mode = effectivePredictionMode(predCfg)
        local hPred = predCfg.X or 0.115
        local vPred = predCfg.Y or 0.115
        local zPred = predCfg.Z or hPred
        if mode == "Regular" then
            aimPos = applyPrediction("Aim Assist", aimPos, aimPart, char, camPos, hPred, vPred, zPred)
        elseif mode == "Ping based" or mode == "Ping Based" then
            local ping = getgenv().CachedPing or 60
            local val = getPingPrediction(ping)
            aimPos = applyPrediction("Aim Assist", aimPos, aimPart, char, camPos, val, val, val)
        elseif mode == "Calculate" then
            local ping = getgenv().CachedPing or 60
            local val = (ping / 1000) + 0.037
            aimPos = applyPrediction("Aim Assist", aimPos, aimPart, char, camPos, val, val, val)
        end
    else
        aimPos = aimPos + Vector3.new(0, getYCompOffsetForTarget("Aim Assist", char), 0)
    end

    if IsAirborne(char) then
        local jumpOff = A("Aim Assist", "JumpOffset", 0)
        if jumpOff and jumpOff ~= 0 then
            aimPos = aimPos + Vector3.new(0, jumpOff, 0)
        end
    else
        local fallOff = A("Aim Assist", "FallOffset", 0)
        if fallOff and fallOff ~= 0 then
            aimPos = aimPos + Vector3.new(0, fallOff, 0)
        end
    end

    local nowT = tick()
    if not currentTarget._lastRayTime or (nowT - currentTarget._lastRayTime) > 1/15 then
        currentTarget._lastRayTime  = nowT
        currentTarget._lastRayOK    = true
        local checks = AA_getChecks()
        if checks.Visible then
            if not isVisible(aimPos, char) then currentTarget._lastRayOK = false end
        end
        if currentTarget._lastRayOK then
            local agEnabled = parseAntiGround("Aim Assist")
            if agEnabled then
                local groundHit = GetGroundIntersection(aimPos, char, "Aim Assist")
                if groundHit then currentTarget._lastRayOK = false end
            end
        end
    end
    if not currentTarget._lastRayOK then return end

    local desiredCF = CFrame.lookAt(camPos, aimPos)

    if _easingState.target ~= char then
        _easingState.target    = char
        _easingState.startTime = nowT
    end

    local easeTable = getTable("Aim Assist", "EasingStyle")
    local rotTable = easeTable and easeTable.Rotation
    local duration = tonumber(rotTable and rotTable.Duration) or 0.15
    local age = nowT - _easingState.startTime

    if age < duration then
        local styleName = (easeTable and easeTable.Position and easeTable.Position.In) or "Sine"
        local easeStyle = getEasingStyle(styleName)
        local progress = math.clamp(age / duration, 0, 1)
        local alpha = TweenService:GetValue(progress, easeStyle, Enum.EasingDirection.Out)
        Camera.CFrame = camCF:Lerp(desiredCF, alpha)
    else
        local combinedSmooth = (_smooth.x + _smooth.y) / 2
        if combinedSmooth <= 0 then combinedSmooth = 0.01 end
        if combinedSmooth > 1 then combinedSmooth = 1 end
        local alpha = 1 - math.exp(-combinedSmooth * dt * 60)
        Camera.CFrame = camCF:Lerp(desiredCF, alpha)
    end
end

local function triggerbotShouldFire()
    local tb = getTable('TriggerBot')
    if not tb or not tb.Enabled then return false end

    if _tbState.keyDefined then
        if not _tbState.toggle then return false end
    end

    local now = tick()
    local delay = tonumber(tb.Delay) or 0.03
    if (now - _tbState.lastShot) < delay then return false end

    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local tbChecks = tb.Checks or {}
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tbChecks.Weapon and (not tool or not isWeapon(tool)) then return false end

    local tgt = nil
    if tb.TargetOnly then
        if tb.TargetOnlySource == 'Silent Aim' then
            tgt = SilentTarget
        else
            tgt = currentTarget
        end
        if not tgt or not tgt.character then return false end
    else
        tgt = selectTarget(getValidEnemies())
        if not tgt or not tgt.character then return false end
    end

    local tChar = tgt.character
    if tbChecks.Knocked and IsKnocked(tChar) then return false end

    local crosshair = Camera.ViewportSize * 0.5
    local refs = getCharRefs(tChar)
    local aimPart = refs.head or refs.root or tgt.rootPart
    if not aimPart then return false end

    local sp, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
    if not onScreen then return false end

    local dist = math.sqrt((sp.X - crosshair.X)^2 + (sp.Y - crosshair.Y)^2)
    if dist > 80 then return false end

    if tbChecks.Visible and not isVisible(aimPart.Position, tChar) then return false end

    return true
end

local function triggerbotTick()
    if not triggerbotShouldFire() then return end
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool then
        pcall(function() tool:Activate() end)
        _tbState.lastShot = tick()
    end
end

local FOOD_NAMES = {"Burger", "Pizza", "Chicken", "Popcorn", "Donut", "Taco", "Super Pizza", "Sauce"}
local STOMP_FOODS = {"Super Pizza", "Sauce"}

local function findFood()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char then return nil end
    local function scan(container)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") then
                local raw = stripBrackets(child.Name)
                for _, food in ipairs(FOOD_NAMES) do
                    if raw:lower() == food:lower() then
                        return child
                    end
                end
            end
        end
        return nil
    end
    local found = scan(backpack)
    if found then return found end
    found = scan(char)
    if found then return found end
    return nil
end

