function getSilentAimPart(char)
    if not char then return nil end
    local method = A("Silent Aim", "Mode", "Direct")
    local refs = getCharRefs(char)
    if method == "Direct" then
        return refs.head or refs.root
    end
    local allParts = getBodyParts(char)
    if #allParts == 0 then return refs.root end
    local crosshair = silentAimCrosshair()
    local checks = SA_getChecks()
    if method == "Closest Part" then
        local best, bestDist = nil, math.huge
        for _, part in ipairs(allParts) do
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dx = screenPos.X - crosshair.X
                local dy = screenPos.Y - crosshair.Y
                local dist = dx * dx + dy * dy
                if dist < bestDist then
                    bestDist = dist
                    best = part
                end
            end
        end
        if not best then best = allParts[1] end
        if checks.Visible and not isVisible(best.Position, char) then
            local vis = findVisiblePart(char, allParts)
            if vis then return vis end
        end
        return best
    end
    if method == "Nearest Point" then
        local ray = Camera:ViewportPointToRay(crosshair.X, crosshair.Y)
        _silentRayParams.FilterDescendantsInstances = allParts
        local result = Workspace:Raycast(ray.Origin, ray.Direction * 10000, _silentRayParams)
        if result and (not checks.Visible or isVisible(result.Position, char)) then
            return result.Instance
        end
        local best, bestDist = nil, math.huge
        for _, part in ipairs(allParts) do
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dx = screenPos.X - crosshair.X
                local dy = screenPos.Y - crosshair.Y
                local dist = dx * dx + dy * dy
                if dist < bestDist then
                    bestDist = dist
                    best = part
                end
            end
        end
        if not best then best = allParts[1] end
        if checks.Visible and not isVisible(best.Position, char) then
            local vis = findVisiblePart(char, allParts)
            if vis then return vis end
        end
        return best
    end
    return refs.head or refs.root
end

local function recalculateVelocity(part)
    if not part then return Vector3.zero end
    local char = part.Parent
    if not char then return Vector3.zero end
    local now = tick()
    local currentPos = part.Position
    local state = _recalcVelState[char]
    if not state then
        _recalcVelState[char] = { pos = currentPos, time = now, vel = Vector3.zero }
        return Vector3.zero
    end
    local dt = now - state.time
    if dt < 0.05 then return state.vel end
    local vel = (currentPos - state.pos) / dt
    state.pos = currentPos
    state.time = now
    state.vel = vel
    return vel
end

local function getResolverVelocity(part)
    if not part then return Vector3.zero end
    local char = part.Parent
    if not char then return Vector3.zero end
    local refs = getCharRefs(char)
    local hum = refs.humanoid
    local observed = hum and (hum.MoveDirection * hum.WalkSpeed) or nil
    local claimed  = part.AssemblyLinearVelocity

    if _realMoving[char] == false then return Vector3.zero end

    local resolverOn   = A("Resolver", "Enabled", false) == true
    local resolverAuto = A("Resolver", "Auto",    false) == true
    local method       = A("Resolver", "Method",  "History")

    local function useResolver()
        if method == "History" then
            return recalculateVelocity(part)
        elseif method == "Intent" and observed then
            return observed
        elseif method == "Facing" and hum then
            return part.CFrame.LookVector * math.max(hum.WalkSpeed, 1)
        end
        return nil
    end

    if resolverOn then
        local v = useResolver()
        if v then
            local prev = _lastResolvedVel[char]
            if prev then v = prev:Lerp(v, 0.35) end
            _lastResolvedVel[char] = v
            return v
        end
    end

    if resolverAuto then
        local now = tick()
        local cached = _T.resolverState[char]
        if not cached or (now - cached.time) > 0.15 then
            cached = { detected = detectAntiAim(part), time = now }
            _T.resolverState[char] = cached
        end
        if cached.detected then
            local v = useResolver()
            if v then
                local prev = _lastResolvedVel[char]
                if prev then v = prev:Lerp(v, 0.35) end
                _lastResolvedVel[char] = v
                return v
            end
        end
    end

    if observed then
        local claimedFlat  = Vector3.new(claimed.X,  0, claimed.Z)
        local observedFlat = Vector3.new(observed.X, 0, observed.Z)
        if (claimedFlat - observedFlat).Magnitude > 15 then
            return observed
        end
    end

    local result = claimed
    local prev = _lastResolvedVel[char]
    if prev then result = prev:Lerp(result, 0.25) end
    _lastResolvedVel[char] = result
    return result
end

local function applyPrediction(section, aimPos, aimPart, char, camPos, sX, sY, sZ)
    sX = sX or 0.115
    sY = sY or 0.115
    sZ = sZ or sX
    local vel = aimPart and getResolverVelocity(aimPart) or Vector3.zero
    local out = aimPos + Vector3.new(vel.X * sX, vel.Y * sY, vel.Z * sZ)
    out = out + Vector3.new(0, getYCompOffsetForTarget(section, char), 0)
    return out
end

local function computeSilentAimPosition(part, predCfg, accuracy)
    if not part then return nil end
    local aimPos = part.Position
    local char = part.Parent

    if predCfg and predictionActive(predCfg) then
        local mode = effectivePredictionMode(predCfg)
        local hPred = predCfg.X or 0.115
        local vPred = predCfg.Y or 0.115
        local zPred = predCfg.Z or hPred

        if mode == "Regular" then
            aimPos = applyPrediction("Silent Aim", aimPos, part, char, Camera.CFrame.Position, hPred, vPred, zPred)
        elseif mode == "Ping based" or mode == "Ping Based" then
            local ping = getgenv().CachedPing or 60
            local val = getPingPrediction(ping)
            aimPos = applyPrediction("Silent Aim", aimPos, part, char, Camera.CFrame.Position, val, val, val)
        elseif mode == "Calculate" then
            local ping = getgenv().CachedPing or 60
            local val = (ping / 1000) + 0.037
            aimPos = applyPrediction("Silent Aim", aimPos, part, char, Camera.CFrame.Position, val, val, val)
        end
    else
        aimPos = aimPos + Vector3.new(0, getYCompOffsetForTarget("Silent Aim", char), 0)
    end

    if accuracy and accuracy < 100 then
        local spread = (100 - accuracy) / 100 * 0.04
        local angle = math.random() * 2 * math.pi
        local randomDir = Vector3.new(math.cos(angle), math.sin(angle), 0) * spread
        aimPos = aimPos + randomDir
    end
    return aimPos
end

