            for _, entry in ipairs(cache) do
                local shouldBuy = false
                if entry.cat == "Gun" and getFlag("AutoBuyGun", true) then
                    if #selectedGuns > 0 then
                        for _, g in ipairs(selectedGuns) do
                            if g == entry.name then shouldBuy = true; break end
                        end
                    else
                        shouldBuy = true
                    end
                elseif entry.cat == "Food" and getFlag("AutoBuyFood", true) then
                    if #selectedFoods > 0 then
                        for _, f in ipairs(selectedFoods) do
                            if f == entry.name then shouldBuy = true; break end
                        end
                    else
                        shouldBuy = true
                    end
                elseif entry.cat == "Armor" and getFlag("AutoBuyArmor", true) then
                    shouldBuy = true
                end
                if shouldBuy and not hasItem(entry.name) then
                    local d = (entry.part.Position - pos).Magnitude
                    if d < prox then
                        if tryBuy(entry.model) then
                            bought = true
                        end
                    end
                end
            end
            if bought then
                lastBuy = tick()
            end
        end)
    end
end)

local strafeActive = false
local strafeDirection = 0
local stepIndex = 1
local steps = {}
local nextChangeTime = 0
local tapEndTime = 0
local isTapping = false
local wasInAir = false
local isPeeking = false
local peekDirection = 0
local peekPhase = 0
local peekStartTime = 0

local evasiveActive = false
local evasiveStepStart = 0
local evasiveBaseDir = 0
local evasivePattern = {}

local PATTERN = "A D A D D A A D A A A D A D"
local LEFT_HOLD = 0.6
local RIGHT_HOLD = 0.3
local PAUSE_HOLD = 0.50
local LEFT_BURST = 0.8
local RIGHT_BURST = 0.4
local PAUSE_BURST = 0.15
local DEADZONE = 0.01
local USE_GAME_WALKSPEED = true
local FIXED_SPEED = 16
local WALL_CHECK_DISTANCE = 2.5
local PEEK_MODE = true
local PEEK_OUT_DURATION = 0.15
local PEEK_BACK_DURATION = 0.15

local ACTIVATION_THRESHOLD = getFlag("ActivationThreshold", 0.3)
local CLOSE_DISTANCE = getFlag("CloseDistance", 20)
local EVASIVE_DURATIONS = {0.2, 0.1, 0.1, 0.1}

local function parsePattern(pattern)
    local chars = {}
    for char in pattern:gmatch("%S") do table.insert(chars, char) end
    local result = {}
    local i = 1
    while i <= #chars do
        local current = chars[i]
        local count = 1
        while i + count <= #chars and chars[i + count] == current do
            count = count + 1
        end
        local dir = 0
        if current == "A" then dir = -1
        elseif current == "D" then dir = 1
        elseif current == "S" then dir = 0
        end
        for _ = 1, count do
            table.insert(result, dir)
        end
        i = i + count
    end
    return result
end

steps = parsePattern(PATTERN)
if #steps == 0 then steps = {-1, 1} end
stepIndex = 1

local function nextStep()
    local dir = steps[stepIndex]
    strafeDirection = dir
    local duration, burst
    if dir == -1 then
        duration = LEFT_HOLD
        burst = LEFT_BURST
    elseif dir == 1 then
        duration = RIGHT_HOLD
        burst = RIGHT_BURST
    else
        duration = PAUSE_HOLD
        burst = PAUSE_BURST
    end
    tapEndTime = tick() + burst
    isTapping = true
    nextChangeTime = tick() + duration
    stepIndex = stepIndex + 1
    if stepIndex > #steps then stepIndex = 1 end
end

nextStep()

local _strafeRayParams = RaycastParams.new()
_strafeRayParams.FilterType = Enum.RaycastFilterType.Exclude
local _strafeIgnoreList = {}
local _lastStrafeWallCheck = 0
local _lastStrafeWallResult = false

local function isDirectionBlocked(direction, camRight, rootPart)
    if direction == 0 then return false end
    local now = tick()
    if now - _lastStrafeWallCheck < 0.25 then
        return _lastStrafeWallResult
    end
    _lastStrafeWallCheck = now
    local dirVec = camRight * direction
    dirVec = Vector3.new(dirVec.X, 0, dirVec.Z).Unit
    local startPos = rootPart.Position + Vector3.new(0, 1, 0)
    _strafeIgnoreList[1] = rootPart.Parent
    _strafeIgnoreList[2] = nil
    _strafeRayParams.FilterDescendantsInstances = _strafeIgnoreList
    local result = workspace:Raycast(startPos, dirVec * WALL_CHECK_DISTANCE, _strafeRayParams)
    _lastStrafeWallResult = result ~= nil
    return _lastStrafeWallResult
end

local _lastAppliedDir = 0

local function strafeHeartbeat()
    if not getFlag("AutoMovement", false) then
        strafeActive = false
        strafeDirection = 0
        isTapping = false
        isPeeking = false
        evasiveActive = false
        _lastAppliedDir = 0
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    if not rootPart or not humanoid then return end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not isWeapon(tool) then
        strafeActive = false
        strafeDirection = 0
        isTapping = false
        isPeeking = false
        evasiveActive = false
        _lastAppliedDir = 0
        return
    end
    local state = humanoid:GetState()
    local stateName = state.Name
    if stateName == "Physics" then
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end
    humanoid.AutoRotate = true
    local inputDir = humanoid.MoveDirection
    if inputDir.Magnitude < DEADZONE then
        strafeActive = false
        strafeDirection = 0
        wasInAir = false
        isPeeking = false
        evasiveActive = false
        if _lastAppliedDir ~= 0 then
            rootPart.Velocity = Vector3.new(0, rootPart.Velocity.Y, 0)
            _lastAppliedDir = 0
        end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local camCF = cam.CFrame
    local camRight = camCF.RightVector
    camRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
    local lateralInput = inputDir:Dot(camRight)
    local inAir = (stateName == "Jumping" or stateName == "Falling" or stateName == "Freefall")
    local shouldActivate = (math.abs(lateralInput) > ACTIVATION_THRESHOLD and not inAir)
    if not shouldActivate then
        if strafeActive then
            strafeActive = false
            strafeDirection = 0
            isTapping = false
            isPeeking = false
            evasiveActive = false
            _lastAppliedDir = 0
        end
        return
    end
    if inAir then
        strafeActive = false
        strafeDirection = 0
        isTapping = false
        isPeeking = false
        evasiveActive = false
        wasInAir = true
        _lastAppliedDir = 0
        return
    end
    if wasInAir and not inAir then
        wasInAir = false
        stepIndex = 1
        nextStep()
        isPeeking = false
        evasiveActive = false
    end
    if not strafeActive then
        strafeActive = true
        stepIndex = 1
        nextStep()
        isPeeking = false
    end
    local useEvasive = false
    if currentTarget and currentTarget.character then
        local enemyRoot = currentTarget.rootPart
        if enemyRoot and enemyRoot.Parent then
            local enemyVel = enemyRoot.AssemblyLinearVelocity
            local lateralEnemy = enemyVel:Dot(camRight)
            if math.abs(lateralEnemy) > 0.2 then
                useEvasive = true
                local dist = (enemyRoot.Position - rootPart.Position).Magnitude
                local dirMultiplier = 1
                if dist < CLOSE_DISTANCE then
                    dirMultiplier = 1
                else
                    dirMultiplier = -1
                end
                local baseDir = math.sign(lateralEnemy) * dirMultiplier
                if evasiveBaseDir ~= baseDir or (not evasiveActive) then
                    evasiveBaseDir = baseDir
                    evasiveActive = true
                    evasiveStepStart = tick()
                    evasivePattern = {baseDir, baseDir, -baseDir, -baseDir}
                end
            else
                evasiveActive = false
            end
        else
            evasiveActive = false
        end
    else
        evasiveActive = false
    end
    if useEvasive and evasiveActive then
        local now = tick()
        local elapsed = now - evasiveStepStart
        local totalDur = EVASIVE_DURATIONS[1] + EVASIVE_DURATIONS[2] + EVASIVE_DURATIONS[3] + EVASIVE_DURATIONS[4]
        local t = elapsed % totalDur
        local accumulated = 0
        local dir = 0
        for i, dur in ipairs(EVASIVE_DURATIONS) do
            if t < accumulated + dur then
                dir = evasivePattern[i]
                break
            end
            accumulated = accumulated + dur
        end
        strafeDirection = dir
        isTapping = true
    else
        local now = tick()
        if not isPeeking then
            if now >= nextChangeTime then
                nextStep()
            elseif isTapping and now >= tapEndTime then
                isTapping = false
                strafeDirection = 0
            end
            if PEEK_MODE and isTapping and strafeDirection ~= 0 then
                if isDirectionBlocked(strafeDirection, camRight, rootPart) then
                    isPeeking = true
                    peekDirection = strafeDirection
                    peekPhase = 0
                    peekStartTime = now
                    isTapping = false
                    strafeDirection = 0
                end
            end
        else
            local elapsed = now - peekStartTime
            if peekPhase == 0 then
                if elapsed < PEEK_OUT_DURATION then
                    strafeDirection = peekDirection
                    isTapping = true
                else
                    peekPhase = 1
                    peekStartTime = now
                    strafeDirection = -peekDirection
                    isTapping = true
                end
            else
                if elapsed < PEEK_BACK_DURATION then
                    strafeDirection = -peekDirection
                    isTapping = true
                else
                    isPeeking = false
                    isTapping = true
                    nextChangeTime = now
                    strafeDirection = 0
                end
            end
        end
    end
    local speed = USE_GAME_WALKSPEED and humanoid.WalkSpeed or FIXED_SPEED
    if speed <= 0 then speed = 16 end
    speed = math.min(speed, 50)
    local effectiveDir = 0
    if strafeActive and isTapping and strafeDirection ~= 0 then
        effectiveDir = strafeDirection
    end
    if effectiveDir ~= _lastAppliedDir then
        _lastAppliedDir = effectiveDir
        local lateralVel = camRight * speed * effectiveDir
        rootPart.Velocity = Vector3.new(lateralVel.X, rootPart.Velocity.Y, lateralVel.Z)
    else
        local v = rootPart.Velocity
        if effectiveDir == 0 and (v.X ~= 0 or v.Z ~= 0) then
            rootPart.Velocity = Vector3.new(0, v.Y, 0)
        end
    end
end

