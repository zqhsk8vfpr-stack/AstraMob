local function attachNameTag(player, character)
    if player == LocalPlayer then return end
    if not getFlag("EnemyESP", false) then return end    -- master gate
    if not getFlag("NameESP", false) then return end     -- sub toggle
    if nameTags[player] then return end
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    if root:FindFirstChild(NAME_TAG_NAME) then
        nameTags[player] = root:FindFirstChild(NAME_TAG_NAME)
        return
    end
    local tag = buildNameTag(player)
    tag.Adornee = root
    tag.Parent = root
    nameTags[player] = tag
end

local function detachNameTag(player)
    local tag = nameTags[player]
    if tag then
        pcall(function() tag:Destroy() end)
        nameTags[player] = nil
    end
end

local function updateNameTagColor(player)
