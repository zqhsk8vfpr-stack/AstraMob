local function getSilentAimPart(char)
    if not char then return nil end
    local method = getFlag("SilentAimMethod", "Direct")
    if method == "Direct" then
        local part = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
        return part
    end
    local allParts = getBodyParts(char)
    if #allParts == 0 then return char:FindFirstChild("HumanoidRootPart") end
    local crosshair = Camera.ViewportSize * 0.5
    if method == "Closest Part" then
        local best, bestDist = nil, math.huge
        for _, part in ipairs(allParts) do
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dx = screenPos.X - crosshair.X
                local dy = screenPos.Y - crosshair.Y
                local dist = dx * dx + dy * dy
                if dist < bestDist then
                    bestDist = dist
                    best = part
                end
            end
        end
        if not best then best = allParts[1] end
        if getFlag("SilentAimWallCheck", false) and not isVisible(best.Position, char) then
            local vis = findVisiblePart(char, allParts)
            if vis then return vis end
        end
        return best
    end
    if method == "Nearest Point" then
        local ray = Camera:ViewportPointToRay(crosshair.X, crosshair.Y)
        _silentRayParams.FilterDescendantsInstances = allParts
        local result = Workspace:Raycast(ray.Origin, ray.Direction * 10000, _silentRayParams)
        if result and (not getFlag("SilentAimWallCheck", false) or isVisible(result.Position, char)) then
            return result.Instance
        end
        local best, bestDist = nil, math.huge
        for _, part in ipairs(allParts) do
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dx = screenPos.X - crosshair.X
                local dy = screenPos.Y - crosshair.Y
                local dist = dx * dx + dy * dy
                if dist < bestDist then
                    bestDist = dist
                    best = part
                end
            end
        end
        if not best then best = allParts[1] end
        if getFlag("SilentAimWallCheck", false) and not isVisible(best.Position, char) then
            local vis = findVisiblePart(char, allParts)
            if vis then return vis end
        end
        return best
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function detectAntiAim(part)
    if not part then return false end
    local hum = part.Parent and part.Parent:FindFirstChildWhichIsA("Humanoid")
    if not hum then return false end
    local vel = part.AssemblyLinearVelocity
    local intent = hum.MoveDirection * hum.WalkSpeed
    local velMag = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local intentMag = intent.Magnitude
    if velMag > 3 and intentMag < 1 then
        return true
    end
    if velMag > 2 and intentMag > 2 then
        local flatVel = Vector3.new(vel.X, 0, vel.Z).Unit
        local flatIntent = intent.Unit
        local dot = flatVel:Dot(flatIntent)
        if dot < -0.3 then
            return true
        end
    end
    local root = part.Parent:FindFirstChild("HumanoidRootPart")
    if root then
        local angVel = root.AssemblyAngularVelocity.Magnitude
        if angVel > 8 then
            return true
        end
    end
    return false
end

local function getResolverVelocity(part)
    if not part then return Vector3.zero end
    local useResolver = false
    if getFlag("Resolver", false) == true then
        useResolver = true
    end
    if getFlag("AutoResolver", false) == true then
        local char = part.Parent
        local now = tick()
        local cached = resolverState[char]
        if not cached or (now - cached.time) > 0.15 then
            local detected = detectAntiAim(part)
            resolverState[char] = { detected = detected, time = now }
            cached = resolverState[char]
        end
        if cached.detected then
            useResolver = true
        end
    end
    if useResolver then
        local hum = part.Parent and part.Parent:FindFirstChildWhichIsA("Humanoid")
        if hum then
            return hum.MoveDirection * hum.WalkSpeed
        end
    end
    return part.AssemblyLinearVelocity
end

local function computeSilentAimPosition(part, usePrediction, useAutoPred, accuracy)
    if not part then return nil end
    local g = getgenv()
    local aimPos = part.Position
    local vel = getResolverVelocity(part)
    if usePrediction then
        local hPred = g.SilentAimPredX or 0.115
        local vPred = g.SilentAimPredY or 0.115
        local zPred = g.SilentAimPredZ or 0.115
        aimPos = aimPos + Vector3.new(vel.X * hPred, vel.Y * vPred, vel.Z * zPred)
    end
    if useAutoPred then
        local hMult = g.SilentAimPredX or 0.115
        local vMult = g.SilentAimPredY or 0.115
        local zMult = g.SilentAimPredZ or 0.115
        aimPos = aimPos + Vector3.new(vel.X * hMult, vel.Y * vMult, vel.Z * zMult)
    end
    if accuracy and accuracy < 100 then
        local spread = (100 - accuracy) / 100 * 0.04
        local angle = math.random() * 2 * math.pi
        local randomDir = Vector3.new(math.cos(angle), math.sin(angle), 0) * spread
        aimPos = aimPos + randomDir
    end
    return aimPos
end

