local function isVisible(targetPos, targetChar)
    if targetChar then
        local now = tick()
        local cached = _visCache[targetChar]
        if cached ~= nil and (now - (_visCacheTime[targetChar] or 0)) < VIS_CACHE_TTL then
            return cached
        end
    end
    if _visIgnoreDirty then rebuildVisIgnore() end
    local origin = Camera.CFrame.Position
    local direction = targetPos - origin
    if direction.Magnitude < 0.001 then return false end
    local hit = Workspace:Raycast(origin, direction, _visRayParams)
    local result
    if not hit then
        result = true
    elseif targetChar and hit.Instance:IsDescendantOf(targetChar) then
        result = true
    else
        result = false
    end
    if targetChar then
        _visCache[targetChar] = result
        _visCacheTime[targetChar] = tick()
    end
    return result
end

local function getBodyParts(char)
    if not char then return {} end
    local now = tick()
    local cached = _bodyPartsCache[char]
    if cached and (now - (_bodyPartsCacheTime[char] or 0)) < 0.2 then
        return cached
    end
    local parts = {}
    for _, child in ipairs(char:GetDescendants()) do
        if child:IsA("BasePart") and child.Transparency < 0.5 then
            local name = child.Name:lower()
            if not name:find("handle") and not name:find("tool") and not name:find("attachment") and not name:find("accessory") then
                table.insert(parts, child)
            end
        end
    end
    _bodyPartsCache[char] = parts
    _bodyPartsCacheTime[char] = now
    return parts
end

local function getClosestBodyPart(char)
    if not char then return nil end
    local parts = getBodyParts(char)
    if #parts == 0 then return nil end
    local crosshair = Camera.ViewportSize * 0.5
    local best, bestDist = nil, math.huge
    for _, part in ipairs(parts) do
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if on then
            local dx = sp.X - crosshair.X
            local dy = sp.Y - crosshair.Y
            local d = dx * dx + dy * dy
            if d < bestDist then
                bestDist = d
                best = part
            end
        end
    end
    return best or parts[1]
end

local function findVisiblePart(char, allParts)
    local now = tick()
    local cached = _lastVisiblePart[char]
    if cached and cached.Parent == char and (now - (_lastVisibleScan[char] or 0)) < VIS_SCAN_INTERVAL then
        return cached
    end
    _lastVisibleScan[char] = now
    for _, part in ipairs(allParts) do
        if isVisible(part.Position, char) then
            _lastVisiblePart[char] = part
            return part
        end
    end
    return nil
end

local function computeHardcodedAimPart(char)
    local mode = getFlag("HitpartSelection", "Direct")
    if mode == "Direct" then
        local head = char:FindFirstChild("Head")
        if head and head:IsA("BasePart") then return head end
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        if torso and torso:IsA("BasePart") then return torso end
        return char:FindFirstChild("HumanoidRootPart")
    end
    local allParts = getBodyParts(char)
    if #allParts == 0 then
        return char:FindFirstChild("HumanoidRootPart")
    end
    local crosshair = Camera.ViewportSize * 0.5
    local best, bestDist = nil, math.huge
    for _, part in ipairs(allParts) do
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if onScreen then
            local dx = screenPos.X - crosshair.X
            local dy = screenPos.Y - crosshair.Y
            local dist = dx * dx + dy * dy
            if dist < bestDist then
                bestDist = dist
                best = part
            end
        end
    end
    if not best then best = allParts[1] end
    if getFlag("AimbotWallCheck", false) and not isVisible(best.Position, char) then
        local vis = findVisiblePart(char, allParts)
        if vis then return vis end
    end
    return best
end

local function getAimPart(char)
    if not char then return nil end
    local now = tick()
    local cached = _aimPartCache[char]
    if cached and (now - (_aimPartCacheTime[char] or 0)) < AIM_PART_CACHE_TTL then
        return cached
    end
    local part
    if getFlag("combat_target_outline", false) then
        part = getClosestBodyPart(char)
        if not part then part = computeHardcodedAimPart(char) end
    else
        part = computeHardcodedAimPart(char)
    end
    _aimPartCache[char] = part
    _aimPartCacheTime[char] = now
    return part
end

function selectClosest(enemies)
    local camPos = Camera.CFrame.Position
    local best, bestDist = nil, math.huge
    for _, data in ipairs(enemies) do
        local root = data.rootPart
        if not root then continue end
        local d = (root.Position - camPos).Magnitude
        if d < bestDist then
            bestDist = d
            best = data
        end
    end
    return best
end

local function selectTarget(enemies)
    if #enemies == 0 then return nil end
    local priority = parseTargetPriority()

    if priority == "manual" then
        return nil
    end

    if priority == "random" then
        return enemies[math.random(1, #enemies)]
    end

    if priority == "lookdirection" then
        local camPos = Camera.CFrame.Position
        local camLook = Camera.CFrame.LookVector
        local bestDot, best = -2, nil
        for _, data in ipairs(enemies) do
            local root = data.rootPart
            if root then
                local delta = root.Position - camPos
                if delta.Magnitude >= 0.001 then
                    local dot = camLook:Dot(delta.Unit)
                    if dot > bestDot then
                        bestDot = dot
                        best = data
                    end
                end
            end
        end
        if best and bestDot > 0 then
            return best
        end
        return nil
    end

    if priority == "closesttocrosshair" then
        local crosshair = Camera.ViewportSize * 0.5
        local best, bestDist = nil, math.huge
        for _, data in ipairs(enemies) do
            local root = data.rootPart
            if not root then continue end
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                local dx = pos.X - crosshair.X
                local dy = pos.Y - crosshair.Y
                local dist = dx * dx + dy * dy
                if dist < bestDist then
                    bestDist = dist
                    best = data
                end
            end
        end
        if not best then
            best = selectClosest(enemies)
        end
        return best
    end

    if priority == "lowesthealth" then
        local best, bestHp = nil, math.huge
        for _, data in ipairs(enemies) do
            local hum = data.humanoid
            if hum and hum.Health < bestHp then
                bestHp = hum.Health
                best = data
            end
        end
        return best
    end

    if priority == "highesthealth" then
        local best, bestHp = nil, -1
        for _, data in ipairs(enemies) do
            local hum = data.humanoid
            if hum and hum.Health > bestHp then
                bestHp = hum.Health
                best = data
            end
        end
        return best
    end

    if priority == "farthest" then
        local camPos = Camera.CFrame.Position
        local best, bestDist = nil, -1
        for _, data in ipairs(enemies) do
            local root = data.rootPart
            if not root then continue end
            local d = (root.Position - camPos).Magnitude
            if d > bestDist then
                bestDist = d
                best = data
            end
        end
        return best
    end

    return selectClosest(enemies)
end

local function IsAirborne(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then return true end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local velY = root.AssemblyLinearVelocity.Y
        if velY > 2 or velY < -2 then return true end
    end
    return false
end

local _groundRayParams = RaycastParams.new()
