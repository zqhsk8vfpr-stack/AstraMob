local function rebuildValidEnemies()
    local now = tick()
    if not validEnemiesDirty and (now - lastRebuildTime) < SAFETY_REBUILD_INTERVAL then
        return
    end
    validEnemiesDirty = false
    lastRebuildTime = now

    local knockCheck = getFlag("AimbotKnockCheck", false)
    local ffCheck = getFlag("AimbotForcefieldCheck", false)

    clearTable(validEnemiesCache)
    clearTable(validEnemiesByPlayer)

    for i = 1, #playerCacheArray do
        local plr = playerCacheArray[i]
        if plr ~= LocalPlayer then
            if not isFriend(plr) then
                local char = plr.Character
                if char and char.Parent then
                    refreshCharRefs(char, false)
                    local refs = getCharRefs(char)
                    local skip = false
                    if knockCheck and IsKnocked(char) then skip = true end
                    if not skip and ffCheck and refs.forcefield then skip = true end
                    if not skip then
                        local hum = refs.humanoid
                        if hum and hum.Health > 0 then
                            local root = refs.root
                            if root and root.Parent then
                                local entry = { player = plr, character = char, humanoid = hum, rootPart = root }
                                table.insert(validEnemiesCache, entry)
                                validEnemiesByPlayer[plr] = entry
                            end
                        end
                    end
                end
            end
        end
    end
end

