local function getPingBucket(ping)
    if not ping then return 60 end
    if ping < 65 then return 60
    elseif ping < 75 then return 70
    elseif ping < 85 then return 80
    elseif ping < 95 then return 90
    else return 100 end
end

local function getPredictionValue(mode)
    if mode == "Advanced" then return nil end
    if mode == "Regular" then
        return nil
    elseif mode == "Ping based" then
        local ping = getgenv().CachedPing or 60
        local bucket = getPingBucket(ping)
        local list = pingPresets[bucket]
        if list and #list > 0 then
            return list[math.random(1, #list)]
        end
    end
    return nil
end

local function scanMotor6Ds(char)
    local broken, total = 0, 0
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Motor6D") then
            total = total + 1
            if not v.Enabled then
                broken = broken + 1
            end
        end
    end
    return total > 0 and broken >= 2
end

local function IsKnocked(char)
    if not char then return true end
    local refs = getCharRefs(char)
    local hum = refs.humanoid
    if not hum then return true end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead then return true end
    if hum.Health <= 0 then return true end
    local root = refs.root
    if root and root.Anchored then return true end
    if hum.PlatformStand then return true end
    if state == Enum.HumanoidStateType.Physics then return true end
    if char:GetAttribute("Ragdolled") == true then return true end
    if char:GetAttribute("Knocked") == true then return true end
    if hum:GetAttribute("Ragdolled") == true then return true end
    if hum:GetAttribute("Knocked") == true then return true end

    local now = tick()
    local cached = _knockCache[char]
    if cached ~= nil and (now - (_knockCacheTime[char] or 0)) < KNOCK_CACHE_TTL then
        return cached
    end
    local result = scanMotor6Ds(char)
    _knockCache[char] = result
    _knockCacheTime[char] = now
    return result
end

