local function isFriendCached(plr)
    local now = tick()
    if _friendCache[plr] ~= nil and (now - (_friendCacheTime[plr] or 0)) < FRIEND_CACHE_TTL then
        return _friendCache[plr]
    end
    local ok, res = pcall(function() return plr:IsFriendsWith(LocalPlayer.UserId) end)
    local val = ok and res or false
    _friendCache[plr] = val
    _friendCacheTime[plr] = now
    return val
end

local function isFriend(plr)
    local tag = playerPriority[plr.UserId]
    if tag == "Friend" then return true end
    if playerlistActive and tag ~= "Enemy" then return true end
    if getFlag("AimbotFriendCheck", false) or getFlag("FriendCheck", false) or getFlag("SilentAimFriendCheck", false) then
        return isFriendCached(plr)
    end
    return false
end

local _prevPos        = setmetatable({}, {__mode = "k"})
local _prevPosTime    = setmetatable({}, {__mode = "k"})
local _realMoving     = setmetatable({}, {__mode = "k"})

local function updateRealMotion(char)
    local refs = getCharRefs(char)
    local root = refs.root
    if not root then return end
    local now = tick()
    local prev, prevT = _prevPos[char], _prevPosTime[char]
    _prevPos[char] = root.Position
    _prevPosTime[char] = now
    if not prev or not prevT then
        _realMoving[char] = false
        return
    end
    local dt = now - prevT
    if dt < 0.001 then return end
    local speed = (root.Position - prev).Magnitude / dt
    local wasMoving = _realMoving[char] == true

    if speed > 4 then
