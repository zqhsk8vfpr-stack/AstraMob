local function antiCurveShouldSkip(camCF, aimPos)
    local ac = SA_getAntiCurve()
    if not ac then return false end

    local method = ac.Method or "3d-Angles"
    if method == "3d-Angles" then
        local value = tonumber(ac.Angle) or 0
        if value <= 0 then return false end
        local delta = aimPos - camCF.Position
        if delta.Magnitude < 0.001 then return false end
        local dot = math.clamp(camCF.LookVector:Dot(delta.Unit), -1, 1)
        local angle = math.deg(math.acos(dot))
        return angle > value
    elseif method == "Pixels" then
        local value = tonumber(ac.Pixels) or 50
        if value <= 0 then return false end
        local sp, on = Camera:WorldToViewportPoint(aimPos)
        if not on then return true end
        local ch = Camera.ViewportSize * 0.5
        local dist = math.sqrt((sp.X - ch.X)^2 + (sp.Y - ch.Y)^2)
        return dist > value
    else -- '1:1'
        local tol = tonumber(ac.Strict) or 2
        local sp, on = Camera:WorldToViewportPoint(aimPos)
        if not on then return true end
        local ch = Camera.ViewportSize * 0.5
        local dist = math.sqrt((sp.X - ch.X)^2 + (sp.Y - ch.Y)^2)
        return dist > tol
    end
end

local function fw_refreshTarget()
    FW.cachedPart = nil
    FW.cachedVelocity = Vector3.zero
    local tgt = SilentTarget
    if not tgt or not tgt.character then
        _fwAimPartRef = nil
        return
    end
    local targetChar = tgt.character
    local now = tick()

    local part = _fwAimPartRef
    if not part or not part.Parent or (now - _fwAimPartTime) > FW_AIMPART_TTL then
        part = getSilentAimPart(targetChar)
        _fwAimPartRef  = part
        _fwAimPartTime = now
        _fwWallOk      = nil
    end
    if not part or not part.Parent then return end

    local checks = SA_getChecks()
    if checks.Visible then
        if _fwWallOk == nil or (now - _fwWallTime) > FW_WALL_TTL then
            _fwWallOk   = isVisible(part.Position, targetChar)
            _fwWallTime = now
        end
        if not _fwWallOk then return end
    end

    local camCF = Camera.CFrame
    if antiCurveShouldSkip(camCF, part.Position) then return end

    FW.cachedPart = part
    local prev  = FW.prevPartPos[part]
    local prevT = FW.prevPartTime[part]
    if prev and prevT then
        local dt = now - prevT
        if dt > 0.001 then
            FW.cachedVelocity = (part.Position - prev) / dt
        end
    end
    FW.prevPartPos[part]  = part.Position
    FW.prevPartTime[part] = now
end

