local function scanMotor6Ds(char)
    local broken, total = 0, 0
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") then
            total = total + 1
            if not v.Enabled then
                broken = broken + 1
            end
        end
    end
    return total > 0 and broken >= 2
end

local function IsKnocked(char)
    if not char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead then return true end
    if hum.Health <= 0 then return true end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and root.Anchored then return true end
    if hum.PlatformStand then return true end
    if state == Enum.HumanoidStateType.Physics then return true end
    if char:GetAttribute("Ragdolled") == true then return true end
    if char:GetAttribute("Knocked") == true then return true end
    if hum:GetAttribute("Ragdolled") == true then return true end
    if hum:GetAttribute("Knocked") == true then return true end

    local now = tick()
    local cached = _knockCache[char]
    if cached ~= nil and (now - (_knockCacheTime[char] or 0)) < KNOCK_CACHE_TTL then
        return cached
    end
    local result = scanMotor6Ds(char)
    _knockCache[char] = result
    _knockCacheTime[char] = now
    return result
end

local function hasForcefield(char)
    return char and char:FindFirstChildOfClass("ForceField") ~= nil
end

local function isFriendCached(plr)
    local now = tick()
    if _friendCache[plr] ~= nil and (now - (_friendCacheTime[plr] or 0)) < FRIEND_CACHE_TTL then
        return _friendCache[plr]
    end
    local ok, res = pcall(function() return plr:IsFriendsWith(LocalPlayer.UserId) end)
    local val = ok and res or false
    _friendCache[plr] = val
    _friendCacheTime[plr] = now
    return val
end

local function isFriend(plr)
    local tag = playerPriority[plr.UserId]
    if tag == "Friend" then return true end
    if playerlistActive and tag ~= "Enemy" then return true end
    if getFlag("AimbotFriendCheck", false) or getFlag("FriendCheck", false) or getFlag("SilentAimFriendCheck", false) then
        return isFriendCached(plr)
    end
    return false
end

local validEnemiesCache = {}
local cacheTime = 0

local function getValidEnemies()
    local now = tick()
    if now - cacheTime < ENEMY_CACHE_TTL then
        return validEnemiesCache
    end
    cacheTime = now
    table.clear(validEnemiesCache)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if isFriend(plr) then continue end
        local char = plr.Character
        if not char then continue end
        if not char.Parent then continue end
        if getFlag("AimbotKnockCheck", false) and IsKnocked(char) then continue end
        if getFlag("AimbotForcefieldCheck", false) and hasForcefield(char) then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("LowerTorso")
        if not root or not root.Parent then continue end
        table.insert(validEnemiesCache, { player = plr, character = char, humanoid = hum, rootPart = root })
    end
    return validEnemiesCache
end

local _visRayParams = RaycastParams.new()
