local function detectAntiAim(part)
    if not part then return false end
    local hum = part.Parent and part.Parent:FindFirstChildWhichIsA("Humanoid")
    if not hum then return false end
    local vel = part.AssemblyLinearVelocity
    local intent = hum.MoveDirection * hum.WalkSpeed
    local velMag = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local intentMag = intent.Magnitude
    if velMag > 3 and intentMag < 1 then return true end
    if velMag > 2 and intentMag > 2 then
        local flatVel = Vector3.new(vel.X, 0, vel.Z).Unit
        local flatIntent = intent.Unit
        if flatVel:Dot(flatIntent) < -0.3 then return true end
    end
    local root = part.Parent:FindFirstChild("HumanoidRootPart")
    if root and root.AssemblyAngularVelocity.Magnitude > 8 then return true end
    return false
end

local function getResolverVelocity(part)
    if not part then return Vector3.zero end
    local char = part.Parent
    if not char then return Vector3.zero end

    local refs = getCharRefs(char)
    local hum = refs.humanoid
    local observed = hum and (hum.MoveDirection * hum.WalkSpeed) or nil
    local claimed = part.AssemblyLinearVelocity

    if not observed then return claimed end

    if _realMoving[char] == false then
        return Vector3.zero
    end

    if getFlag("Resolver", false) == true then
        return observed
    end

    local useObserved = false

    if getFlag("AutoResolver", false) == true then
        local now = tick()
        local cached = resolverState[char]
        if not cached or (now - cached.time) > 0.15 then
            local detected = detectAntiAim(part)
            resolverState[char] = { detected = detected, time = now }
            cached = resolverState[char]
        end
        if cached and cached.detected then useObserved = true end
    end

    local claimedFlat  = Vector3.new(claimed.X,  0, claimed.Z)
    local observedFlat = Vector3.new(observed.X, 0, observed.Z)
    if (claimedFlat - observedFlat).Magnitude > 15 then
        useObserved = true
    end

    local result = useObserved and observed or claimed

    local prev = _lastResolvedVel[char]
    if prev then
        result = prev:Lerp(result, 0.25)
    end
    _lastResolvedVel[char] = result
    return result
end

local function createABTracker()
    return {
        px = 0, py = 0, pz = 0,
        vx = 0, vy = 0, vz = 0,
        init = false,
        last = tick(),
    }
end

local function updateAdvancedTracker(char, part, dt)
    if not char or not part then return end
    local t = _advancedTrackers[char]
    if not t then
        t = createABTracker()
        _advancedTrackers[char] = t
        t.last = tick()
        return
    end

    if dt <= 0 then dt = 1 / 30 end
    if dt > 0.5 then dt = 0.5 end
    t.last = tick()

    local alpha = tonumber(getFlag("ABAlpha", 0.5)) or 0.5
    local beta  = tonumber(getFlag("ABBeta",  0.15)) or 0.15
    if alpha < 0.01 then alpha = 0.01 end
    if alpha > 1 then alpha = 1 end
    if beta < 0 then beta = 0 end
    if beta > 1 then beta = 1 end

    local p = part.Position

    if not t.init then
        t.px, t.py, t.pz = p.X, p.Y, p.Z
        t.vx, t.vy, t.vz = 0, 0, 0
        t.init = true
        return
    end

    local predX = t.px + t.vx * dt
    local predY = t.py + t.vy * dt
    local predZ = t.pz + t.vz * dt

    local rx = p.X - predX
    local ry = p.Y - predY
    local rz = p.Z - predZ

    t.px = predX + alpha * rx
    t.py = predY + alpha * ry
    t.pz = predZ + alpha * rz

    t.vx = t.vx + (beta / dt) * rx
    t.vy = t.vy + (beta / dt) * ry
    t.vz = t.vz + (beta / dt) * rz
end

local function getAdvancedPredicted(char, aimPart, timeAhead)
    local t = _advancedTrackers[char]
    if not t or not t.init then return nil end
    if not aimPart or not aimPart.Parent then return nil end
    local refs = getCharRefs(char)
    local root = refs.root
    if not root then return nil end
    timeAhead = timeAhead or 0.115

    local predRoot = Vector3.new(
        t.px + t.vx * timeAhead,
        t.py + t.vy * timeAhead,
        t.pz + t.vz * timeAhead
    )
    local offset = aimPart.Position - root.Position
    return predRoot + offset
end

local function getAdvancedTimeAhead(aimPos, camPos)
    local manual = getgenv().AdvancedTimeAhead
    if manual and not getFlag("AdvancedAutoTime", true) then
        return tonumber(manual) or 0.115
    end
    local bulletSpeed = tonumber(getFlag("BulletSpeed", 800)) or 800
    local ping = (getgenv().CachedPing or 60) / 1000
    local dist = (aimPos - camPos).Magnitude
    return dist / math.max(bulletSpeed, 1) + ping * 0.5
end

