local function cacheGet(ck)
    local t = _configCacheTime[ck]
    if t ~= nil and (tick() - t) < CONFIG_CACHE_TTL then
        return true, _configCache[ck]
    end
    return false, nil
end

local function cacheSet(ck, v)
    _configCache[ck] = v
    _configCacheTime[ck] = tick()
end

function A(section, key, default)
    local ck = section .. "|" .. key
    local hit, v = cacheGet(ck)
    if hit then
        if v == nil then return default end
        return v
    end
    local s = Shared.Astra[section]
    local raw
    if s then raw = s[key] end
    cacheSet(ck, raw)
    if raw == nil then return default end
    return raw
end

function getTable(section, key)
    local s = Shared.Astra[section]
    if not s then return nil end
    if key == nil then return s end
    return s[key]
end

