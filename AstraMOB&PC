local function updateESP()
    local masterOn = _espMasterOn
    local nameOn = _espNameOn
    local distOn = _espDistOn
    local boxOn = _espBoxOn

    if not masterOn then
        for _, tags in pairs(esp_tags) do
            if tags.NameGui and tags.NameGui.Enabled then tags.NameGui.Enabled = false end
            if tags.DistGui and tags.DistGui.Enabled then tags.DistGui.Enabled = false end
            if tags.BoxFrame and tags.BoxFrame.Visible then tags.BoxFrame.Visible = false end
        end
        return
    end

    local camPos = Camera.CFrame.Position

    for i = 1, #playerCacheArray do
        local plr = playerCacheArray[i]
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char then
                local refs = getCharRefs(char)
                local root = refs.root
                if root and root.Parent then
                    if not esp_tags[plr] then
                        createESP(plr)
                    end

                    local tags = esp_tags[plr]

                    if tags.NameGui.Adornee ~= root then tags.NameGui.Adornee = root end
                    if tags.NameGui.Parent ~= root then tags.NameGui.Parent = root end
                    if tags.NameGui.Enabled ~= nameOn then tags.NameGui.Enabled = nameOn end

                    if nameOn then
                        local displayName = plr.DisplayName
                        if tags.LastName ~= displayName then
                            tags.LastName = displayName
                            tags.NameLabel.Text = displayName
                        end
                        local isEnemy = playerPriority[plr.UserId] == "Enemy"
                        local color = isEnemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 255, 255)
                        if tags.LastNameColor ~= color then
                            tags.LastNameColor = color
                            tags.NameLabel.TextColor3 = color
                        end
                    end

                    if tags.DistGui.Adornee ~= root then tags.DistGui.Adornee = root end
                    if tags.DistGui.Parent ~= root then tags.DistGui.Parent = root end
                    if tags.DistGui.Enabled ~= distOn then tags.DistGui.Enabled = distOn end

                    if distOn then
                        local d = tostring(math.round((root.Position - camPos).Magnitude)) .. "m"
                        if tags.LastDist ~= d then
                            tags.LastDist = d
                            tags.DistLabel.Text = d
                        end
                    end

                    if tags.BoxFrame.Visible ~= boxOn then tags.BoxFrame.Visible = boxOn end
                    if boxOn then
                        local head = refs.head
                        if head and head.Parent then
                            local headPos, onScreen1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                            local feetPos, onScreen2 = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.5, 0))

                            if onScreen1 and onScreen2 then
                                local height = math.abs(headPos.Y - feetPos.Y)
                                local width = height * 0.6
                                local newSize = UDim2.new(0, width, 0, height)
                                local newPos = UDim2.new(0, headPos.X - (width / 2), 0, headPos.Y)

                                if tags.LastBoxSize ~= newSize then
                                    tags.LastBoxSize = newSize
                                    tags.BoxFrame.Size = newSize
                                end
                                if tags.LastBoxPos ~= newPos then
                                    tags.LastBoxPos = newPos
                                    tags.BoxFrame.Position = newPos
                                end

                                local isEnemy = playerPriority[plr.UserId] == "Enemy"
                                local color = isEnemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 255, 255)
                                if tags.LastBoxColor ~= color then
                                    tags.LastBoxColor = color
                                    tags.BoxStroke.Color = color
                                end
                            else
                                tags.BoxFrame.Visible = false
                            end
                        end
                    end
                end
            end
        end
    end
end

