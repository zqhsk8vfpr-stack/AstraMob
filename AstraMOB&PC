local function isKeyboardKeyCode(key)
    if typeof(key) ~= "EnumItem" then return false end
    local name = key.Name or ""
    if name:find("^Button") or name:find("^DPad") or name:find("^Thumbstick") then
        return false
    end
    return true
end

local function getKeyCode(name)
    if typeof(name) == "EnumItem" then return name end
    if type(name) == "number" then
        for _, code in pairs(Enum.KeyCode:GetEnumItems()) do
            if code.Value == name then return code end
        end
    end
    if type(name) ~= "string" then name = tostring(name) end
    local upper = name:upper()
    for _, code in pairs(Enum.KeyCode:GetEnumItems()) do
        if code.Name:upper() == upper then return code end
    end
    return Enum.KeyCode.E
end

