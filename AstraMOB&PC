local function computeSilentAimPosition(part, usePrediction, useAutoPred, accuracy)
    if not part then return nil end
    local g = getgenv()
    local aimPos = part.Position
    local char = part.Parent

    if usePrediction or useAutoPred then
        local mode = getFlag("SilentAimAutoPredictionMode", "Regular")
        local hPred = g.SilentAimPredX or 0.115
        local vPred = g.SilentAimPredY or 0.115
        local zPred = g.SilentAimPredZ or 0.115
        aimPos = applyPrediction(aimPos, part, char, Camera.CFrame.Position, mode, hPred, vPred, zPred)
    end

    if accuracy and accuracy < 100 then
        local spread = (100 - accuracy) / 100 * 0.04
        local angle = math.random() * 2 * math.pi
        local randomDir = Vector3.new(math.cos(angle), math.sin(angle), 0) * spread
        aimPos = aimPos + randomDir
    end
    return aimPos
end

