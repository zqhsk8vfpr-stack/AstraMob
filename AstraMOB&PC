local prevLookVectors = {}
local function recordLookVector()
    local v = Camera.CFrame.LookVector
    prevLookVectors[#prevLookVectors + 1] = v
    if #prevLookVectors > 5 then
        table.remove(prevLookVectors, 1)
    end
end

local function getMovementDirection()
    if #prevLookVectors < 2 then return nil end
    local avg = Vector3.zero
    for i = 2, #prevLookVectors do
        avg += (prevLookVectors[i] - prevLookVectors[i - 1])
    end
    if avg.Magnitude < 0.001 then return nil end
    return avg.Unit
end

local function easeOutSine(t) return math.sin((t * math.pi) / 2) end
local function easeOutQuad(t) return 1 - (1 - t) * (1 - t) end
local function easeOutCubic(t) return 1 - math.pow(1 - t, 3) end
local function easeOutQuart(t) return 1 - math.pow(1 - t, 4) end
local function easeOutExpo(t) return 1 - math.pow(2, -10 * t) end
local function easeOutBack(t) local c1=1.70158; local c3=2.70158; return 1 + c3*(t-1)^3 + c1*(t-1)^2 end

local function getEasedValue(t, style, dir)
    style = style or "Linear"
    dir = dir or "Out"
    t = math.clamp(t, 0, 1)
    if dir == "In" then t = 1 - t end
    if dir == "InOut" then
        return t < 0.5 and getEasedValue(2*t, style, "Out")/2 or 0.5 + getEasedValue(2*t-1, style, "Out")/2
    end
    if style == "Sine" then return easeOutSine(t) end
    if style == "Quad" then return easeOutQuad(t) end
    if style == "Cubic" then return easeOutCubic(t) end
    if style == "Quart" then return easeOutQuart(t) end
    if style == "Exponential" then return easeOutExpo(t) end
    if style == "Back" then return easeOutBack(t) end
    return t
end

