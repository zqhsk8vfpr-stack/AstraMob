local function GetGroundIntersection(aimPos, targetChar, section)
    section = section or "Aim Assist"

    local agEnabled, agMode = parseAntiGround(section)
    if not agEnabled then return nil end

    local origin = Camera.CFrame.Position
    local direction = aimPos - origin
    if direction.Magnitude < 0.001 then return nil end

    local ignoreList = {}
    if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
    if targetChar then table.insert(ignoreList, targetChar) end
    _groundRayParams.FilterDescendantsInstances = ignoreList

    local result = Workspace:Raycast(origin, direction, _groundRayParams)
    if not result then return nil end
    local hitPart = result.Instance
    if not hitPart or not hitPart:IsA("BasePart") then return nil end

    if agMode == "AnyHit" then
        return result.Position
    elseif agMode == "Ground" then
        if isGroundLike(hitPart, result.Normal) then return result.Position end
        return nil
    else
        if isGroundLike(hitPart, result.Normal) then return result.Position end
        if isCharacterPart(hitPart) then return nil end
        return result.Position
    end
end

