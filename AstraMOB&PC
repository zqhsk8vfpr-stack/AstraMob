local function getCharRefs(char)
    local r = charRefs[char]
    if r then return r end
    r = {
        humanoid = nil,
        head = nil,
        root = nil,
        forcefield = nil,
        lastCheck = 0,
    }
    charRefs[char] = r
    return r
end

local function refreshCharRefs(char, force)
    local r = getCharRefs(char)
    local now = tick()
    if force or (now - r.lastCheck) > 0.5 then
        r.humanoid = char:FindFirstChildOfClass("Humanoid") or r.humanoid
        r.head = char:FindFirstChild("Head") or r.head
        r.root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or r.root
        r.forcefield = char:FindFirstChildOfClass("ForceField")
        r.lastCheck = now
    end
    return r
end

