local function getYCompOffset(section)
    local yc = getTable and getTable('YCompensation') or Shared.Astra['YCompensation']
    if not yc or not yc.Enabled then return 0 end
    if section == "Silent Aim" and yc.ApplyToSilent == false then return 0 end
    if section == "Aim Assist" and yc.ApplyToAimAssist == false then return 0 end

    local mode = yc.Legitness or 'Balanced'
    local base
    if mode == 'Strict' then
        base = 0.05
    elseif mode == 'Aggressive' then
        base = 0.30
    else
        base = 0.18
    end
    local mult = tonumber(yc.JumpMultiplier) or 1
    return base * mult
end

local function getYCompOffsetForTarget(section, char)
    if not char then return 0 end
    local refs = getCharRefs and getCharRefs(char)
    local hum = refs and refs.humanoid
    if not hum then return 0 end
    local st = hum:GetState()
    local airborne = st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Jumping
    if not airborne then return 0 end
    return getYCompOffset(section)
end

