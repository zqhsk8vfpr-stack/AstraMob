local function getWeaponHitChance(tool)
    if not tool or not tool:IsA("Tool") then return nil end
    local cached = _weaponHitCache[tool]
    if cached ~= nil then
        if cached == false then return nil end
        return cached
    end
    if getFlag("GunConfigEnabled", true) == false then
        _weaponHitCache[tool] = false
        return nil
    end
    local rawName = tool.Name:gsub("^%[(.*)%]$", "%1")
    local configs = getgenv().GunConfigs or {}
    local cfg = configs[rawName]
    local result = nil
    if cfg and type(cfg.HitChance) == "number" then
        result = math.clamp(cfg.HitChance, 0, 100)
    else
        local flagName = rawName:gsub(" ", "") .. "HitChance"
        local hit = getFlag(flagName, nil)
        if type(hit) == "number" then result = math.clamp(hit, 0, 100) end
    end
    _weaponHitCache[tool] = result or false
    return result
end

local function prepareSilentAim()
    if not isSilentAimActive() then return end
    local currentTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
    if currentTool and not isWeapon(currentTool) then return end
    local hitChance = getFlag("SilentAimHitChance", 85)
    if currentTool then
        local weaponHit = getWeaponHitChance(currentTool)
        if weaponHit then hitChance = weaponHit end
    end
    if math.random(100) > hitChance then return end
    local targetPlayer = SilentTarget
    if not targetPlayer or not targetPlayer.character then return end
    if targetPlayer.character ~= targetPlayer.player.Character then return end
    local targetChar = targetPlayer.character
    if getFlag("SilentAimKnockCheck", false) and IsKnocked(targetChar) then return end
    if getFlag("SilentAimForcefieldCheck", false) and hasForcefield(targetChar) then return end
    if getFlag("SilentAimFriendCheck", false) and isFriendCached(targetPlayer.player) then return end
    local hum = targetChar:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local aimPart = getSilentAimPart(targetChar)
    if not aimPart then return end
    if getFlag("SilentAimWallCheck", false) and not isVisible(aimPart.Position, targetChar) then return end
    local aimPos = computeSilentAimPosition(aimPart, getFlag("SilentAimPrediction", false), getFlag("SilentAimAutoPrediction", false), hitChance)
    local antiCurve = getFlag("SilentAimAntiCurve", 8)
    if antiCurve > 0 then
        local camCF = Camera.CFrame
        local dir = (aimPos - camCF.Position).Unit
        local angle = math.deg(math.acos(camCF.LookVector:Dot(dir)))
        if angle > antiCurve then return end
    end
    if getFlag("SilentAimAntiGround", false) then
        local groundHit = GetGroundIntersection(aimPos, targetChar)
        if groundHit then return end
    end
    fireSilentAim(aimPos)
end

