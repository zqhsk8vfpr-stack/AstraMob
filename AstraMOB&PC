local function isGroundLike(inst, normal)
    if not inst then return false end
    if inst:IsA("Terrain") then return true end
    if normal and normal.Y > 0.6 then return true end
    local n = inst.Name:lower()
    if n:find("ground") or n:find("floor") or n:find("baseplate")
       or n:find("platform") or n:find("terrain") or n:find("grass") then
        return true
    end
    return false
end

