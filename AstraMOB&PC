local function isFirstPerson()
    local char = LocalPlayer.Character
    if not char then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    return (Camera.CFrame.Position - head.Position).Magnitude < 1.0
end

local function passesPerspectiveCheck(sectionName)
    local s = Shared.Astra[sectionName]
    if not s then return true end
    local checks = s['Checks']
    if not checks then return true end

    local fp = checks['First Person'] == true
    local tp = checks['Third Person'] == true

    if not fp and not tp then return true end

    local firstPerson = isFirstPerson()
    if fp and firstPerson   then return true end
    if tp and not firstPerson then return true end
    return false
end

