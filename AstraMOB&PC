    if _timers.aimbotAcquire >= _rates.aimbotAcquire then
        _timers.aimbotAcquire -= _rates.aimbotAcquire
        aimbotAcquireTargets()
    end

    if perfShouldRunCamera() then
        aimbotUpdateCamera(dt)
    end
end)

RunService.Heartbeat:Connect(function(dt)
    _timers.maintenance = _timers.maintenance + dt
    _timers.slow        = _timers.slow + dt
    _timers.enemyShot   = _timers.enemyShot + dt
    _timers.fw          = _timers.fw + dt
    _timers.trigger     = _timers.trigger + dt

    if _timers.trigger >= _rates.trigger then
        _timers.trigger -= _rates.trigger
        local tb = getTable('TriggerBot')
        if tb and tb.Enabled then
            if (not _tbState.keyDefined) or _tbState.toggle then
                pcall(triggerbotTick)
            end
        end
    end

    if _timers.enemyShot >= _rates.enemyShot then
        _timers.enemyShot -= _rates.enemyShot
        pcall(pollEnemyShots)
    end

    if _timers.maintenance >= _rates.maintenance then
        _timers.maintenance -= _rates.maintenance
        updateRealMotionAll()
    end

    if _timers.fw >= _rates.fw then
        _timers.fw -= _rates.fw
        if perfShouldRunFW() then
            fw_refreshTarget()
        end
    end

    if _timers.slow >= _rates.slow then
        _timers.slow -= _rates.slow
        pcall(updatePingAndPrediction)
    end
end)

end)()
