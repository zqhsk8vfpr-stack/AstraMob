local function rebuildVisIgnore()
    table.clear(_visIgnoreList)
    if LocalPlayer.Character then
        _visIgnoreList[1] = LocalPlayer.Character
    end
    _visRayParams.FilterDescendantsInstances = _visIgnoreList
    _visIgnoreDirty = false
end

